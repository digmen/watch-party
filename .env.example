# Copy to .env and fill in real values. Never commit .env.

# --- Postgres ---
POSTGRES_USER=watchparty
POSTGRES_PASSWORD=change-me
POSTGRES_DB=watchparty
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://watchparty:change-me@postgres:5432/watchparty

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Backend ---
BACKEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
COOKIE_SECRET=change-me-cookie
CSRF_SECRET=change-me-csrf

# --- Google OAuth (M1) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# --- Video cache (M3) ---
VIDEO_CACHE_PATH=/data/video-cache
# NOTE: parsed but not enforced yet — nothing evicts the cache today. See TODO.md.
VIDEO_CACHE_TTL_HOURS=24
MAX_CONCURRENT_STREAMS=8

# --- Guests (M6) ---
# A room link is the invite, so anyone holding it can join. This is the ceiling per room.
MAX_GUESTS_PER_ROOM=20
# How long an inactive guest account survives before the nightly cleanup removes it. Guests who
# are still connected, or who posted in chat, are never removed regardless of age.
GUEST_TTL_DAYS=7

# --- Cloudflare Tunnel (M4) ---
# Quick Tunnel mode needs no token/config — leave unset intentionally.
