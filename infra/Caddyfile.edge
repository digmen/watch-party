# Edge for the Prague host, where port 443 is shared with Xray (personal VPN).
#
# Since 20.11.2026 the site is https://kerry.zone — DIRECT, no Cloudflare proxy (from Russia,
# Cloudflare cut every response at ~20 KB; directly the server gives 11 MB/s from Moscow).
#
# Port 443 belongs to HAProxy on the host (infra/haproxy/haproxy.cfg): it reads the TLS SNI and
# passes kerry.zone to this Caddy on 127.0.0.1:9444 (with PROXY protocol, so we still see the
# viewer's real IP) and everything else to Xray. :80 serves Let's Encrypt HTTP-01 and redirects.
{
	admin off
	servers :9444 {
		listener_wrappers {
			proxy_protocol {
				allow 172.16.0.0/12 127.0.0.1/32
			}
			tls
		}
	}
}

kerry.zone:9444 {
	encode zstd gzip

	@api path /api* /auth* /socket.io*
	handle @api {
		reverse_proxy backend:3000 {
			flush_interval -1
			transport http {
				read_timeout 3600s
				write_timeout 3600s
			}
		}
	}

	handle {
		reverse_proxy frontend:80
	}
}

# Plain HTTP and the interim direct address (used for a few hours on 20.11) → the real one.
http://kerry.zone, http://tv.kerry.zone {
	redir https://kerry.zone{uri} 308
}
tv.kerry.zone:9443 {
	redir https://kerry.zone{uri} 301
}

# Old Cloudflare-proxied hostname (Origin Rule → 9443): only redirects. Named explicitly — a
# host-less block with a manual `tls` would pin its self-signed cert for every SNI.
# Only Cloudflare may talk to it — list from https://www.cloudflare.com/ips-v4 and -v6.
watch.kerry.zone:9443 {
	tls /certs/watch.pem /certs/watch.key

	@notcf not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	handle @notcf {
		respond "forbidden" 403
	}

	# Keeps Google sign-in working until https://kerry.zone/auth/google/callback is registered in
	# Google Cloud; the callback is then switched in .env and this exception can go.
	handle /auth/google/callback {
		redir https://kerry.zone{uri} 302
	}

	handle {
		redir https://kerry.zone{uri} 301
	}
}
