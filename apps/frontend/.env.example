VITE_API_ORIGIN=http://localhost:3000

# Public origin of the deployed site, e.g. https://watchparty.example — used for canonical URLs,
# og:url and absolute sitemap entries. Leave it empty on purpose while the app runs on a
# Cloudflare Quick Tunnel: that hostname is random and changes on every restart, and a wrong
# canonical URL is worse than none, so those tags are simply omitted when this is unset.
# Not yet wired into the Docker build (see TODO.md) — today it only affects a local `vite build`.
VITE_PUBLIC_ORIGIN=
