{
  "name": "@watch-party/backend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "bun --env-file=../../.env dist/main.js",
    "start:dev": "nest start --watch --builder swc --exec \"bun --env-file=../../.env run\"",
    "lint": "biome check .",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env run src/database/migrate.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/csrf-protection": "^7.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/oauth2": "^8.1.2",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^11.0.11",
    "@nestjs/config": "^4.0.1",
    "@nestjs/core": "^11.0.11",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.11",
    "@nestjs/platform-socket.io": "^11.0.11",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/swagger": "^11.0.6",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.0.11",
    "@socket.io/redis-adapter": "^8.3.0",
    "@watch-party/shared": "workspace:*",
    "bullmq": "^5.41.2",
    "drizzle-orm": "^0.39.1",
    "fastify": "^5.2.1",
    "fastify-socket.io": "^5.1.0",
    "ioredis": "^5.4.2",
    "nestjs-zod": "^4.2.0",
    "postgres": "^3.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.4",
    "@nestjs/schematics": "^11.0.1",
    "@nestjs/testing": "^11.0.11",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.16",
    "@types/node": "^22.13.4",
    "bun-types": "^1.3.14",
    "drizzle-kit": "^0.30.4",
    "typescript": "^5.7.0"
  }
